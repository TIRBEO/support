{
  "name": "@tirbeo/theme",
  "version": "1.0.0",
  "description": "Tirbeo design tokens, CSS variables, and theme provider",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@tirbeo/config": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.3.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

